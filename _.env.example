# General
MAX_WORKERS=8
FETCH_TIMEOUT=15
PING_TIMEOUT=8
PING_RETRIES=1
LATENCY_THRESHOLD_MS=5000
TELEGRAM_MESSAGES_PER_CHANNEL=20
GEOIP_ENABLED=true
GEOIP_CACHE_TTL_SECONDS=86400
OUTPUT_DIR=configs
LOG_LEVEL=INFO
MAX_CONFIGS_PER_OUTPUT=0

# Real health-check (xray-core)
XRAY_PATH=xray
TEST_URL=http://cp.cloudflare.com
XRAY_STARTUP_DELAY=1.5

# Two-stage TCP fast filter (before xray)
TCP_FILTER_LIMIT=2000
TCP_FILTER_WORKERS=100
TCP_FILTER_TIMEOUT=2.0
